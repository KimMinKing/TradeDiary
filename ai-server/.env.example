# AI Server Environment Variables

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Model Configuration (choose one)
# For GPT-4o mini (recommended for cost efficiency)
AI_MODEL=gpt-4o-mini

# For Claude 3.5 Sonnet (alternative)
# AI_MODEL=claude-3-5-sonnet-20241022

# Database Configuration
DATABASE_URL=postgresql://tradediary:tradediary@postgres:5432/tradediary

# JWT Configuration (for API calls to backend)
JWT_SECRET=your_jwt_secret_here
AI_SERVER_API_KEY=replace-with-a-long-random-internal-key

# Exchange API Configuration
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET=your_binance_secret
UPBIT_API_KEY=your_upbit_api_key
UPBIT_SECRET=your_upbit_secret

# Logging Configuration
LOG_LEVEL=INFO
ENABLE_DEMO_MODE=false

# Feature Flags
ENABLE_AI_CHALLENGE=true
ENABLE_EMOTION_ANALYSIS=true
ENABLE_CHART_ANALYSIS=true
ENABLE_GAMEIFICATION=true

# Performance Settings
MAX_TOKENS=1000
TEMPERATURE=0.3
REQUEST_TIMEOUT=30
